{
  "name": "agy-quota-rings",
  "version": "1.2.0",
  "description": "Minimalist Material 3 dual-ring token quota indicator (5h + Weekly) for Antigravity Desktop on macOS and Windows.",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/suseirin-lab/agy-quota-rings.git"
  },
  "homepage": "https://github.com/suseirin-lab/agy-quota-rings#readme",
  "bugs": {
    "url": "https://github.com/suseirin-lab/agy-quota-rings/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "scripts": {
    "start": "node src/watcher.mjs",
    "launch": "node src/watcher.mjs --launch --relaunch --exit-on-host-close",
    "once": "node src/watcher.mjs --once",
    "remove": "node src/watcher.mjs --remove",
    "build:win": "node scripts/build-windows.mjs",
    "build:mac": "node scripts/build-macos.mjs",
    "check": "node --check src/quota-rings.js && node --check src/watcher.mjs"
  },
  "keywords": [
    "antigravity",
    "quota",
    "token",
    "material-3",
    "google-sans",
    "codex",
    "macos",
    "windows"
  ]
}
